# EmailJS credentials for the contact form.
# 1. Create a free account at https://www.emailjs.com
# 2. Add an Email Service, create an Email Template, and copy the 3 IDs below.
# 3. Copy this file to ".env" and paste your values.
# Without these, the contact form falls back to opening the visitor's email app.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
